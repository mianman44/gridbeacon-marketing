NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Reddit Pixel ID for the /reddit paid landing page (Reddit Ads >
# Events Manager). Optional: when empty, no pixel is loaded. Read at
# BUILD time -- on the VPS, set REDDIT_PIXEL_ID in /opt/gmb-tracker/.env;
# scripts/deploy-vps.sh passes it to the image build. The pixel only
# fires on gridbeaconhq.com, never on local or preview hosts.
NEXT_PUBLIC_REDDIT_PIXEL_ID=

# Google Ads tag for the /google-ads landing page (Google Ads > Goals >
# Conversions > tag setup; the ID looks like AW-123456789). Optional:
# when empty, no Ads tag loads. The label is optional too: set it to
# count a signup-button click as a conversion (AW-ID/label). Build-time
# values -- on the VPS set GOOGLE_ADS_ID and GOOGLE_ADS_SIGNUP_LABEL in
# /opt/gmb-tracker/.env. Loads only on gridbeaconhq.com.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=

# Free Google Maps rank checker (/google-maps-rank-checker).
# The API the public tool calls; the same backend the app uses.
NEXT_PUBLIC_API_URL=

# Cloudflare Turnstile widget key (public). The matching secret is
# TURNSTILE_SECRET_KEY on the backend and is never sent to a browser.
# Leave empty locally and set FREE_TOOL_REQUIRE_TURNSTILE=false on
# the backend; in production set both.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
